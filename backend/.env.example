# Async DSN used by the app (Unix-domain socket — research R3)
DATABASE_URL=postgresql+asyncpg:///checkout?host=/tmp

# scripts/seed.py — catalog size and per-item starting stock
CATALOG_SIZE=2000
STOCK_PER_ITEM=10000

# app/services/inventory.py — alert crossings and the default query threshold
LOW_STOCK_THRESHOLD=50

# app/services/analytics.py — hopping window (contract defaults)
POPULAR_WINDOW_SIZE=1000
POPULAR_SLIDE_INTERVAL=500

# app/background.py — abandoned-transaction sweeper
TX_ABANDON_MINUTES=5

# app/db.py — per-worker pool; keep WORKERS x DB_POOL_SIZE < max_connections (200)
DB_POOL_SIZE=12

# scripts/run_server.sh
WORKERS=4
