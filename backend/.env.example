# Host-side settings for the test suite and the scripts/ shims. The compose stack sets its
# own values per service (compose.yaml; specs/007-microservices-architecture/contracts/
# compose-topology.md), so this file does not affect `docker compose up` except where noted.

# Async DSN (Unix-domain socket to a native PostgreSQL, 001 research R3). The tests derive
# their own databases from it: checkout_checkout_test and checkout_inventory_test.
# Catalog's store is a CSV file (a temporary one in tests) and Analytics has no store.
DATABASE_URL=postgresql+asyncpg:///checkout?host=/tmp

# Seeding: catalog size and per-item starting stock (compose reads these too)
CATALOG_SIZE=2000
STOCK_PER_ITEM=10000

# Inventory: alert crossings and the default report threshold
LOW_STOCK_THRESHOLD=50

# Analytics: hopping window (contract defaults) and the pipeline's scan tail: idle poll
# interval, and how long a sequence hole may stay open before it is skipped
POPULAR_WINDOW_SIZE=1000
POPULAR_SLIDE_INTERVAL=500
POPULAR_POLL_MS=100
POPULAR_GAP_GRACE_MS=1000

# Checkout: abandoned-transaction sweeper, and how long a completion may sit mid-saga before
# the recovery loop picks it up
TX_ABANDON_MINUTES=5
RECOVERY_LEASE_S=10

# Database credentials, read by compose. Each database has its own role; a service is given
# only its own. Catalog has no database credentials (its protection is the read-only volume
# mount) and neither does Analytics.
CHECKOUT_DB_USER=checkout_user
CHECKOUT_DB_PASSWORD=checkout_pass
INVENTORY_DB_USER=inventory_user
INVENTORY_DB_PASSWORD=inventory_pass

# Gateway-mode tests (quickstart V5) reach the databases on their published debug ports
# CHECKOUT_TEST_DATABASE_URL=postgresql+asyncpg://checkout_user:checkout_pass@127.0.0.1:5442/checkout
# INVENTORY_TEST_DATABASE_URL=postgresql+asyncpg://inventory_user:inventory_pass@127.0.0.1:5443/inventory
