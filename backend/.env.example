# Host-side settings for the test suite and the scripts/ shims. The compose stack
# sets its own values per service (compose.yaml; specs/005-service-architecture/
# data-model.md §4), so this file does not affect `docker compose up`.

# Async DSN (Unix-domain socket to a native PostgreSQL — 001 research R3).
# Tests derive their own `<name>_test` database from it.
DATABASE_URL=postgresql+asyncpg:///checkout?host=/tmp

# checkout_data.seed — catalog size and per-item starting stock
CATALOG_SIZE=2000
STOCK_PER_ITEM=10000

# Checkout (alert crossings) and Inventory (default report threshold)
LOW_STOCK_THRESHOLD=50

# Analytics — hopping window (contract defaults) and the persistent pipeline's
# scan tail: idle poll interval, and how long a sequence hole may stay open
POPULAR_WINDOW_SIZE=1000
POPULAR_SLIDE_INTERVAL=500
POPULAR_POLL_MS=100
POPULAR_GAP_GRACE_MS=1000

# Checkout — abandoned-transaction sweeper
TX_ABANDON_MINUTES=5

# Per-process pool; keep the sum of WORKERS x DB_POOL_SIZE across all services
# below PostgreSQL max_connections (200; 005 research R8)
DB_POOL_SIZE=12
WORKERS=4
