{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checkout.stock-reservation-requested payload (the envelope's `data`)",
  "type": "object",
  "properties": {
    "transactionId": {
      "type": "string",
      "pattern": "^tx-[0-9]+$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "sku",
          "quantity"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "transactionId",
    "epoch",
    "lines"
  ],
  "additionalProperties": true
}
